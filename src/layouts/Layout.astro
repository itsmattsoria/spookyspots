---
import '../styles/fonts.css';
import '../styles/main.css';

const { pageTitle } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Spooky Spots - {pageTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<h1 class="font-display site-title">Spooky Spots</h1>
			<div class="type-step-1">An exhaustive directory of spooky & horror-themed businesses & locations</div>
		</header>

		<slot />

		<footer class="site-footer">
			<p>© 2026 Spooky Spots. All rights reserved.</p>
		</footer>
	</body>
</html>

<style>
	.site-header {
		text-align: center;
	}

	.site-title {
		line-height: 0.9;
		font-size: 12vw;
		text-align: center;
		margin: 0 0 var(--space-l);
		text-transform: capitalize;
	}

	/* Footer */
	.site-footer {
		margin-block-start: var(--space-3xl);
	}
</style>
