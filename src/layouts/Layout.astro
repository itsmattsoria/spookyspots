---
import '../styles/fonts.css';
import '../styles/main.css';

const { pageTitle } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Spooky Spots - {pageTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<div>
				<h1 class="font-display site-title distortion-filter">Spooky Spots</h1>
				<div class="type-step-0">A directory of spooky & horror-themed businesses & locations</div>
			</div>
			<div>
				<a href="https://forms.gle/doTGS7f46pdkyYHx5" target="_blank" class="button">Submit a spot!</a>
			</div>
		</header>

		<slot />

		<footer class="site-footer">
			<p>© 2026 Spooky Spots. A fun little project by <a href="https://www.mattsoria.com">Matt Soria</a>.</p>
		</footer>

		<!-- credit: https://kirgroup.net/blog/2025/07/21-SVG-Hand-Drawing-without-js.html -->
		<svg id="filter-svg" style="position: absolute; width: 0px; height: 0px;" xmlns="http://www.w3.org/2000/svg" version="1.1" width="400" height="400" viewBox="0 0 400 400">
			<defs>
				<filter id="distortionFilter">
					<feTurbulence
						type="turbulence"
						baseFrequency="0.01"
						numOctaves="4"
						seed="1"
						result="noise"
						id="feTurbulence1">
						<animate
						id="turbolente-baseFrequency-anim"
						attributeName="baseFrequency"
						values="0.01;0.013;0.011;0.012"
						calcMode="discrete"
						repeatCount="indefinite"
						dur=".4" />
					</feTurbulence>
					<feDisplacementMap
					in="SourceGraphic"
					in2="noise"
					scale="2"
					xChannelSelector="R"
					yChannelSelector="G"
					id="feDisplacementMap1" />
				</filter>
			</defs>
		</svg>
	</body>
</html>

<style is:global>
	.site-header {
		display: flex;
		flex-wrap: wrap;
		align-items: start;
		row-gap: var(--space-s);
		column-gap: var(--space-xs);
		padding-inline: var(--space-m);
		justify-content: space-between;
		padding-block-start: var(--space-m);
	}

	.site-title {
		font-size: 15vw;
		line-height: 0.8;
		text-transform: capitalize;
		margin: 0 0 var(--space-xs);

		@media screen and (min-width: 768px) {
			font-size: 9vw;
		}
	}

	/* Footer */
	.site-footer {
		margin-block-start: var(--space-3xl);
	}
</style>
