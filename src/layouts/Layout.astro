---
import '../styles/fonts.css';
import '../styles/main.css';
import InstagramIcon from '../assets/instagram.svg';
import KoFiIcon from '../assets/kofi_symbol.svg';

const { pageTitle } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Spoooky.biz - {pageTitle}</title>
		<meta name="description" content="The most comprehensive directory of halloween, horror, and otherwise spooky-themed businesses from around the world. With over 250 year-round spooky businesses from 40 U.S. states and 35 countries." />
		<meta name="og:title" content=`Spoooky.biz - ${pageTitle}` />
		<meta name="og:description" content="The most comprehensive directory of halloween, horror, and otherwise spooky-themed businesses from around the world. With over 250 year-round spooky businesses from 40 U.S. states and 35 countries." />
		<meta name="og:url" content="https://spoooky.biz" />
		<meta name="og:type" content="website" />
		<meta name="og:site_name" content="Spoooky.biz" />
		<meta name="og:locale" content="en_US" />
		<meta name="og:locale:alternate" content="en_US" />
	</head>
	<body>
		<header class="site-header site-padding">
			<a href="#main-content" class="skip-link">Skip to main content</a>

			<div class="site-header-title">
				<h1 class="font-display type-step-3 site-title distortion-filter"><a href="/">Spoooky.biz</a></h1>
				<div class="tagline type-step--1">a directory of halloween, horror, and otherwise spooky-themed businesses</div>
			</div>
			<nav aria-label="Primary">
				<ul class="site-nav">
					<li>
						<a href="/about" class="button" style="--button-rotation: -4deg;" aria-current={pathname.replace('/', '') === 'about' ? 'page' : null }><span>About</span></a>
					</li>
					<li>
						<a href="/spooklight" class="button" style="--button-rotation: 1deg;" aria-current={pathname.replace('/', '') === 'spooklight' ? 'page' : null }><span>Spooklight</span></a>
					</li>
					<li>
						<a href="https://forms.gle/doTGS7f46pdkyYHx5" class="button" style="--button-rotation: 3deg;"><span>Submit a biz!</span></a>
					</li>
				</ul>
			</nav>
		</header>

		<main id="main-content" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer site-padding">
			<p class="type-step-1 font-display distortion-filter">👻 Support your local spooky business 👻</p>
			<div class="social-links flex flex-wrap justify-center gap-xs">
				<a href="https://ko-fi.com/itsmattsoria" target="_blank" class="button button--sm" style="--button-rotation: -1deg;"><KoFiIcon /><span>Support us on Ko-fi</span></a>
				<a href="https://www.instagram.com/spoooky.biz/" target="_blank" class="button button--sm" style="--button-rotation: 4deg;" aria-label="Follow us on Instagram"><InstagramIcon /></a>
			</div>
			<p class="type-step--2">Qustions, feedback, or bug reports: <a href="mailto:hellospoookybiz@gmail.com">hellospoookybiz@gmail.com</a></p>
			<p class="type-step--2">© {new Date().getFullYear()} Spoooky.biz 🎃 A fun little project by <a href="https://www.mattsoria.com">Matt Soria</a>.</p>
		</footer>

		<!-- credit: https://kirgroup.net/blog/2025/07/21-SVG-Hand-Drawing-without-js.html -->
		<svg id="filter-svg" style="position: absolute; width: 0px; height: 0px;" xmlns="http://www.w3.org/2000/svg" version="1.1" width="400" height="400" viewBox="0 0 400 400">
			<defs>
				<filter id="distortionFilter">
					<feTurbulence
						type="turbulence"
						baseFrequency="0.01"
						numOctaves="4"
						seed="1"
						result="noise"
						id="feTurbulence1">
						<animate
						id="turbolente-baseFrequency-anim"
						attributeName="baseFrequency"
						values="0.01;0.013;0.011;0.012"
						calcMode="discrete"
						repeatCount="indefinite"
						dur=".4" />
					</feTurbulence>
					<feDisplacementMap
					in="SourceGraphic"
					in2="noise"
					scale="2"
					xChannelSelector="R"
					yChannelSelector="G"
					id="feDisplacementMap1" />
				</filter>
			</defs>
		</svg>

		<!-- border turbulence filter -->
		<svg xmlns="http://www.w3.org/2000/svg" version="1.1" height="0" width="0">
			<defs>
				<filter id="border-noise">
					<feTurbulence type="fractalNoise" baseFrequency=".05" numOctaves="4" />
					<feDisplacementMap in="SourceGraphic" scale="2" />
				</filter>
			</defs>
		</svg>
	</body>
</html>

<style is:global>
	.site-header {
		display: flex;
		flex-wrap: wrap;
		align-items: start;
		row-gap: var(--space-s);
		column-gap: var(--space-xs);
		justify-content: space-between;
		padding-block-start: var(--space-m);
	}

	.site-header-title {
		h1 {
			margin-block-end: var(--space-3xs);
		}

		a {
			text-decoration: none;
			&:hover {
				font-style: normal;
				text-decoration: underline;
				text-decoration-thickness: 0.05em;
			}
		}
	}

	.site-title {
		line-height: 0.8;
		color: var(--color-accent);
		text-transform: capitalize;
		margin: 0 0 var(--space-xs);
	}

	.tagline {
		text-wrap: balance;
	}

	.site-nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-s);

		a[aria-current="page"] {
			text-decoration: underline;
		}
	}

	/* Footer */
	.site-footer {
		display: flex;
		text-align: center;
		gap: var(--space-s);
		flex-direction: column;
		justify-content: center;
		padding-block-end: var(--space-l);
		margin-block-start: var(--space-3xl);

		.social-links {
			margin-block: var(--space-s);
		}
	}
</style>

<script>
	import { Splide } from '@splidejs/splide';
	import '@splidejs/splide/css';

	const carousels = document.querySelectorAll('.carousel');

	carousels.forEach(carousel => {
		// Find the closest parent <details> element
		const details = carousel.closest('details');

		const mountCarousel = () => {
				// Guard: only mount once
				if (carousel.dataset.splideMounted) return;
				carousel.dataset.splideMounted = 'true';

				new Splide(carousel, {
						type: 'slide',
						perPage: 1,
						perMove: 1,
						pagination: true,
						arrows: true,
						lazyLoad: 'nearby',
						preloadPages: 3,
				}).mount();
		};

		if (details) {
			// If it's already open on load, mount immediately
			if (details.open) {
				mountCarousel();
			} else {
				// Mount the first time the details is expanded
				details.addEventListener('toggle', () => {
					if (details.open) mountCarousel();
				});
			}
		} else {
			// No parent <details>? Fall back to mounting normally.
			mountCarousel();
		}
	});
</script>