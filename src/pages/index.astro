---
import Layout from '../layouts/Layout.astro';
import Directory from '../components/Directory.astro';

const directoryResponse = await fetch(import.meta.env.DIRECTORY_DATA_SOURCE_URL);
const directoryData = await directoryResponse.json();
---

<Layout pageTitle="Directory of Spooky & Horror-themed Businesses & Locations">
	<Directory directoryData={directoryData} />
</Layout>
