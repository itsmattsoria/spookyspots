---
import Layout from '../layouts/Layout.astro';
---

<Layout pageTitle="Spooklight - Interviews with the Creators and Operators of your favorite spooky businesses">
  <div class="page-content">
    <section id="about" class="site-padding">
      <div class="section-header">
        <h1 class="type-step-3 font-display distortion-filter section-title">
          Spooklight 
          <span class="button" style="--button-rotation: 2deg"><span>Coming Soon</span></span>
        </h1>

        <p>We'll be sharing regular interviews with the creators and operators of some of our favorite spooky businesses and institutions. Check back soon, and follow us on <a href="https://www.instagram.com/spoooky.biz/" target="_blank">Instagram</a> to stay updated!</p>
      </div>
    </section>
  </div>
</Layout>

