---

<style define:vars={{ objectPosition }}>
  .img-container {
    width: 100%;
    height: 100%;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--space-3xs);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  /* .bkgdHandler {
    background-color: #ffffff;
    background-image: var(--imgBkgd);
    background-repeat: no-repeat;
    background-position: var(--objectPosition);
    background-size: cover;
  } */

  @keyframes fadeIn {
    0% {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .animate-fade {
    animation: fadeIn 750ms ease-in-out;
  }
</style>

<div class={divClass}>
  <img
    class={imgClass}
    data-splide-lazy={defaultSrc}
    data-splide-lazy-srcset={Srcset}
    alt={alt}
    width={width}
    height={height}
    sizes={dataSzes}
    style={`object-position: ${objectPosition};`}
  />
</div>
