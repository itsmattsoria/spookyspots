---
import { fetchRecords } from '../scripts/fetch-records';
import type { Listing } from '../schemas/listing';
import { typeColors } from '../schemas/typeColors';
import CloseIcon from '../assets/close.svg';
import CaratIcon from '../assets/carat.svg';

let directoryData = null;
let errorMessage = null;

try  {
	directoryData = await fetchRecords();
} catch (err: any) {
	errorMessage = err.message;
  console.error(err);
}

const listingCount = directoryData?.length;

// make a copy of directoryData and reformat it to be a GeoJSON object
const geoJsonData = directoryData?.map((item: Listing) => {
  return {
    type: 'Feature',
    geometry: {
      type: 'Point',
      coordinates: [Number(item.latLong.split(',')[1]), Number(item.latLong.split(',')[0])]
    },
    properties: {
      id: item.name.toLowerCase() + ' ' + item.type.toLowerCase() + ' ' + item.address.toLowerCase() + ' ' + item.tags,
      name: item.name,
      type: item.type.toLowerCase(),
      description: item.description,
      address: item.address,
      website: item.website,
      instagram: item.instagram,
      phone: item.phone,
      mapUrl: item.mapUrl,
      color: typeColors.find((type) => type.name === item.type)?.color || '#F78148',
      tags: item.tags
    }
  }
});

// Get all unique types, and their count
const uniqueTypes: { name: string, count: number }[] = [];
const uniqueTags: { name: string, count: number }[] = [];
directoryData?.forEach((item: Listing) => {
  // Get the types
  const type = uniqueTypes.find((type) => type.name.toLowerCase() === item.type.toLowerCase());
  if (type) {
    type.count++;
  } else {
    uniqueTypes.push({ name: item.type.toLowerCase(), count: 1 });
  }

  // Get the tags
  const tags = item?.tags?.split(',').map(tag => tag.trim());
  tags?.forEach((tagItem) => {
    const tag = uniqueTags.find((tag) => tag.name === tagItem);
    if (tag) {
      tag.count++;
    } else {
      uniqueTags.push({ name: tagItem, count: 1 });
    }
  });
});
uniqueTypes.sort((a, b) => b.count - a.count);
uniqueTags.sort((a, b) => a.name.localeCompare(b.name));

// resort directoryData alphabetically by name
const sortedDirectoryData = directoryData?.sort((a: Listing, b: Listing) => a.name.localeCompare(b.name));
---

<div id="directory-container" class="directory-container" data-directory-data={JSON.stringify(geoJsonData)}>

  <div class="filters site-padding">
    <div class="filters-wrapper">
      <div class="input-wrap">
        <label for="search">Search</label>
        <div class="search-input-wrap">
          <input id="search" type="text" placeholder="Search by Name, Location, or Type" class="fuzzy-search search-input" />
          <button id="clearBtn" class="clear-btn" aria-label="Clear search"><CloseIcon /></button>
        </div>
      </div>
      
      <div class="input-wrap">
        <label for="type-filter">Filter by type</label>
        <div class="select-wrap">
          <select id="type-filter">
            <option value="">All</option>
            {uniqueTypes.map((type) => <option value={type.name}>{type.name} ({type.count})</option>)}
          </select>
        </div>
      </div>

      <div class="input-wrap">
        <label for="sort-by">Filter by tags</label>
        <select multiple="multiple" class="multiple-select" placeholder="Select tags" data-facet="tags">
          {uniqueTags.map((tag) => tag.name !== '' && <option value={tag.name}>{tag.name} ({tag.count})</option>)}
        </select>
      </div>

      <div>
        <button id="clearAllFilters" class="clear-filters-btn hidden" aria-hidden="true">
          <CloseIcon />
          <span>Clear filters</span>
        </button>
      </div>
    </div>
    <div class="font-display type-step-0 distortion-filter"><span id="listing-count">{listingCount}</span> spooky spots</div>
  </div>

  <div class="map-container">
    <div id="map"></div>
  </div>

  <div class="directory-list-wrapper">
    <ul id="directory-list" class="directory-list list" role="list">
      {sortedDirectoryData?.map((item: Listing) => (
        <li class="directory-list-item" data-type={item.type.toLowerCase()} data-tags={item.tags} data-id={item.name.toLowerCase() + ' ' + item.type.toLowerCase() + ' ' + item.address.toLowerCase() + ' ' + item.tags}>
          <details>
            <summary>
              <div class="directory-list-item-header">
                <div class="type-step-1 name" style={`color: ${typeColors.find((color) => color.name === item.type)?.color || '#F78148'}`}>{item.name}</div>
               <div class="type-step--1">
                <span style={`color: ${typeColors.find((color) => color.name === item.type)?.color || '#F78148'}`}>{item.type}</span> {item.address && <a href={item.mapUrl} target="_blank" class="location font-mono type-step--2">{item.address}</a>}
               </div>
              </div>
              <div>
                <div class="tag summary-icon">
                  <CaratIcon />
                </div>
              </div>
            </summary>
            <div class="directory-list-item-content">
              {item.description && <div>{item.description}</div>}
              {item.phone && <div>{item.phone}</div>}
              <div>
                {item.website && <a href={item.website} target="_blank" aria-label="Visit {item.name}'s website">Website</a>}{item.website && item.instagram && <span> | </span>}{item.instagram && <a href={item.instagram} target="_blank" aria-label="Visit {item.name}'s Instagram">Instagram</a>}
              </div>
              <div>
                <a href={`mailto:matt.soria@hey.com?subject=Spooky Spots:Change Report for ${item.name}`} class="color-warning type-step--2">Report a change to this spot</a>
              </div>
            </div>
          </details>
        </li>
      ))}
    </ul>
  
    <div id="empty-state" class="empty-state" style="display: none;">
      <p><span class="font-display type-step-4 distortion-filter">Boo!</span><br> Sorry, but we didn't find any spooky spots that match your search. Try again with different filters.</p>
    </div>
  </div>
</div>

<script>
  import {Map, setWorkerUrl, GeolocateControl, Popup, NavigationControl, LngLatBounds} from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';
  import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';
  import styleUrl from '../assets/map-theme.json';
  import List from 'list.js';
  import { type MultipleSelectInstance, multipleSelect } from 'multiple-select-vanilla';
  import 'multiple-select-vanilla/dist/styles/css/multiple-select.css';
  const mapInitialCenter: [number, number] = [0, 0];
  const mapInitialZoom = 1;

  setWorkerUrl(workerUrl);

  const directoryData = JSON.parse(document.getElementById('directory-container')?.dataset.directoryData || '[]');

  // await document.fonts.load("16px 'Ginza Loop'");

  const map = new Map({
      container: 'map', // container id
      style: styleUrl, // style URL
      center: mapInitialCenter, // starting position [lng, lat]
      zoom: mapInitialZoom // starting zoom
  });

  // Disable mouse wheel scrolling soom, but keep pinch-to-zoom enabled
  map.getCanvasContainer().addEventListener('wheel', (e) => {
    // Trackpad pinch gestures pass ctrlKey: true natively in modern browsers
    if (!e.ctrlKey) {
      // Stop standard mouse-wheel scrolling from reaching MapLibre
      e.stopPropagation();
    }
  }, { capture: true, passive: false });

  const layerIDs: Array<string> = [];

  map.on('load', () => {
    map.addSource('spookySpots', {
        'type': 'geojson',
        'data': {
          'type': 'FeatureCollection',
          'features': directoryData
        }
    });

    directoryData.forEach((feature) => {
      const name = feature.properties.name;
      const type = feature.properties.type;
      const address = feature.properties.address;
      const tags = feature.properties.tags;
      const layerID = feature.properties.name.toLowerCase() + ' ' + feature.properties.type.toLowerCase() + ' ' + feature.properties.address.toLowerCase() + ' ' + feature.properties.tags;

      // Add a layer for this symbol type if it hasn't been added already.
      if (!map.getLayer(layerID)) {
        map.addLayer({
          'id': layerID,
          'type': 'circle',
          'source': 'spookySpots',
          'paint': {
            'circle-radius': 7,
            'circle-color': ['get', 'color'],
          },
          // use filter to only show the features that match the search value
          'filter': ['all', ['==', ['get', 'name'], name], ['==', ['get', 'type'], type], ['==', ['get', 'address'], address], ['==', ['get', 'tags'], tags]]
        });

        layerIDs.push(layerID);

        map.on('click', layerID, (e) => {
          // Extract the coordinate where the user clicked
          const coordinates = e.lngLat;

          const popupContent = `
            <div class="font-sans type-step-0">${e.features[0].properties.name}</div>
            <div><span class="tag" style="--tag-color: ${e.features[0].properties.color}">${e.features[0].properties.type}</span></div>
            <div><a href="${e.features[0].properties.mapUrl}" target="_blank">${e.features[0].properties.address}</a></div>
            <div>${e.features[0].properties.phone}</div>
            <div><a href="${e.features[0].properties.website}" target="_blank">Website</a> | <a href="${e.features[0].properties.instagram}" target="_blank">Instagram</a></div>
          `;

          // 2. Create and render the popup
          new Popup()
            .setLngLat(coordinates)
            .setHTML(popupContent)
            .addTo(map);
        });

        // 3. Optional: Change the cursor to a pointer when hovering over the layer
        map.on('mouseenter', layerID, () => {
          map.getCanvas().style.cursor = 'pointer';
        });

        // 4. Optional: Reset the cursor when leaving the layer
        map.on('mouseleave', layerID, () => {
          map.getCanvas().style.cursor = '';
        });
      }
    });
  });

  // Add geolocate control to the map.
  map.addControl(
    new GeolocateControl({
      positionOptions: {
        enableHighAccuracy: true
      },
      trackUserLocation: true
    })
  );

  // Add zoom and rotation controls to the map.
  map.addControl(new NavigationControl({
    showZoom: true,
    showCompass: true
  }));

  // List.js functionality for search, sort, and filter
  const listingCount = document.getElementById('listing-count');
  const emptyState = document.getElementById('empty-state');
  const directoryList = new List('directory-container', {
    valueNames: [
      'name', 
      'location', 
      { data: ['type'] },
      { data: ['tags'] },
      { data: ['id'] }
    ],
  });

  directoryList.on('updated', () => {
    const listingLength = directoryList.matchingItems.length;
    listingCount.textContent = listingLength.toString();
    if (listingLength === 0) {
      emptyState.style.display = 'block';
    } else {
      emptyState.style.display = 'none';
    }
  });

  // Filtering functionality
  const clearAllFilters = document.getElementById('clearAllFilters');
  const filterState = {
    search: '',
    type: '',
    // Each Multiple Select Vanilla instance registers its own facet key here,
    // e.g. { tags: [...], neighborhood: [...] }
    facets: {} as Record<string, string[]>
  }

  clearAllFilters?.addEventListener('click', () => {
    resetFilters();
  });

  const typeFilter = document.getElementById('type-filter');
  typeFilter?.addEventListener('change', function() {
    const selectedType = this.value;
    filterState.type = selectedType;
    applyFilters();
  });

  // Multiple select functionality
  // Each instance controls its own facet, identified by the element's `data-facet`.
  // Facets are matched generically against a matching `data-<facet>` on each list item
  // and `feature.properties[<facet>]` on the map data.
  const multiSelectInstances: MultipleSelectInstance[] = [];
  const multipleSelectElements = document.querySelectorAll<HTMLSelectElement>('.multiple-select');

  multipleSelectElements.forEach((filterElement) => {
    const facet = filterElement.dataset.facet;
    if (!facet) return; // skip any multiselect that hasn't declared a facet

    // Initialize this facet's state
    filterState.facets[facet] = [];

    const instance = multipleSelect(filterElement, {
      maxHeight: 200,
      filter: true,
      showClear: true,
      showSearchClear: true,
      selectAll: false,
      onChange: () => {
        filterState.facets[facet] = instance.getSelects('value') as string[];
        applyFilters();
      }
    }) as MultipleSelectInstance;

    multiSelectInstances.push(instance);
  });


  // Filter the sources in the map when the search input changes
  const searchInput = document.getElementById('search');
  const clearBtn = document.getElementById('clearBtn');

  // Toggle button visibility based on text existence
  function toggleClearBtn() {
    if (searchInput?.value.length > 0) {
      clearBtn.removeAttribute('hidden');
      clearBtn.style.opacity = '1';
      clearBtn.style.pointerEvents = 'auto';
    } else {
      clearBtn.setAttribute('hidden', '');
    }
  }

  // Clear input field on button click
  clearBtn.addEventListener('click', () => {
    searchInput.value = '';
    filterState.search = '';
    toggleClearBtn();
    applyFilters();
    searchInput.focus();
  });

  searchInput?.addEventListener('keyup', (e: Event) => {
    toggleClearBtn();

    const value = e.target.value.trim().toLowerCase();
    filterState.search = value;
    applyFilters();
  });

  // Apply filters to the map and list
  function applyFilters() {
    const flattenedFilterState = [
      filterState.search,
      filterState.type,
      ...Object.values(filterState.facets).flat()
    ].join(' ').trim();

    if (flattenedFilterState === '') {
      directoryList.search();
      directoryList.filter();
      layerIDs.forEach((layerID) => {
        map.setLayoutProperty(
          layerID,
          'visibility',
          'visible'
        );
      });
      hideClearAllFilters();
    } else {
      // true only if every active facet matches this item/feature
      const matchesAllFacets = (getValue: (facet: string) => string) =>
        Object.entries(filterState.facets).every(([facet, selected]) =>
          selected.every(val => (getValue(facet) || '').includes(val))
        );

      directoryList.filter(function(item) {
        const matchesSearch = item.values().id.toLowerCase().includes(filterState.search);
        const matchesType = filterState.type === '' || item.values().type === filterState.type;
        const matchesFacets = matchesAllFacets(facet => item.values()[facet]);

        return matchesSearch && matchesType && matchesFacets;
      });

      directoryData.forEach((feature) => {
        const matchesSearch = feature.properties.id.includes(filterState.search);
        const matchesType = filterState.type === '' || feature.properties.type === filterState.type;
        const matchesFacets = matchesAllFacets(facet => feature.properties[facet]);

        map.setLayoutProperty(
          feature.properties.id,
          'visibility',
          matchesSearch && matchesType && matchesFacets ? 'visible' : 'none'
        );
      });

      showClearAllFilters();
    }

    recenterMap();
  }

  // Recenter the map based on visible layers
  function recenterMap() {
    const visibleLayers = layerIDs.filter((layerID) => map.getLayoutProperty(layerID, 'visibility') === 'visible');
    const visibleSet = new Set(visibleLayers);
    const visibleFeatures = directoryData.filter(feature => visibleSet.has(feature.properties.id));

    if (visibleFeatures.length < layerIDs.length) {
      const bounds = new LngLatBounds();
      visibleFeatures.forEach((feature) => {
        bounds.extend(feature.geometry.coordinates);
      });
      map.fitBounds(bounds, {
        padding: 100,
        maxZoom: 10
      });
    } else {
      // recenter map when all layers are visible
      map.setCenter(mapInitialCenter);
      map.setZoom(mapInitialZoom);
    }
  }

  function resetFilters() {
    searchInput.value = '';
    typeFilter.value = '';

    filterState.search = '';
    filterState.type = '';
    Object.keys(filterState.facets).forEach((facet) => {
      filterState.facets[facet] = [];
    });

    // Uncheck every Multiple Select Vanilla instance
    multiSelectInstances.forEach((instance) => {
      instance.uncheckAll();
    });

    applyFilters();
    toggleClearBtn();
  }

  function showClearAllFilters() {
    clearAllFilters?.classList.remove('hidden');
    clearAllFilters?.setAttribute('aria-hidden', 'false');
  }

  function hideClearAllFilters() {
    clearAllFilters?.classList.add('hidden');
    clearAllFilters?.setAttribute('aria-hidden', 'true');
  }
</script>

<style is:global>
  .directory-container {
    display: grid;
    align-items: start;
    margin-block: var(--space-l);

    @media screen and (min-width: 768px) {
      column-gap: var(--space-xs);
      grid-template-columns: repeat(12, 1fr);
    }
  }

  /* Filters */
  .filters {
    top: 0;
    z-index: 10;
    width: 100%;
    position: sticky;
    grid-column: 1 / -1;
    padding-block: var(--space-s);
    background-color: var(--color-bg-primary);
  }

  /* Directory List */
  .directory-list-wrapper {
    padding: var(--space-l) var(--space-xs-m) 0;

    @media screen and (min-width: 768px) {
      grid-column: 1 / 5;
      padding: 0 0 0 var(--space-m);
    }
  }
  .directory-list {
    margin: 0;
    padding: 0;
    list-style: none;

    .directory-list-item {
      border-top: 1px solid color-mix(in srgb, var(--color-fg-primary) 50%, transparent);

      &:last-child {
        border-bottom: 1px solid color-mix(in srgb, var(--color-fg-primary) 50%, transparent);
      }

      details {
        &[open] {
          .summary-icon svg {
            transform: rotate(180deg);
          }
        }
      }

      summary {
        display: flex;
        cursor: pointer;
        align-items: start;
        gap: var(--space-2xs);
        justify-content: space-between;
        padding: var(--space-xs) var(--space-3xs);

        &:hover,
        &:focus-visible {
          background-color: color-mix(in srgb, var(--color-fg-primary) 10%, transparent);
        }
      }

      .directory-list-item-header {
        display: flex;
        gap: var(--space-3xs);
        flex-direction: column;
      }

      .directory-list-item-content {
        display: flex;
        text-wrap: pretty;
        gap: var(--space-2xs);
        flex-direction: column;
        font-size: var(--step--1);
        margin-top: var(--space-2xs);
        padding-block-end: var(--space-s);
      }
    }
  }

  .empty-state {
    padding-block-start: var(--space-l);
  }

  /* Map */
  .map-container {
    height: 500px;
    position: relative;

    @media screen and (min-width: 768px) {
      order: 2;
      position: sticky;
      grid-column: 5 / -1;
      height: calc(100vh - (var(--space-l) * 3));
      top: calc((var(--space-s) * 2) + var(--step--1) + var(--space-3xs) + var(--space-l) + var(--space-3xs));
    }
  }

  #map {
    width: 100%;
    height: 100%;
    overflow: hidden;
    
    &.maplibregl-map {
      font-family: var(--font-sans);
    }
  
    .maplibregl-popup-content {
      display: flex;
      gap: var(--space-3xs);
      flex-direction: column;
      font-size: var(--step--2);
      font-family: var(--font-mono);
      color: var(--color-bg-primary);
    }

    @media screen and (min-width: 768px) {
      border-radius: var(--space-3xs) 0 0 var(--space-3xs);
    }
  }
</style>