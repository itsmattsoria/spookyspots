---
const { directoryData } = Astro.props;
import type { Listing } from '../schemas/listing';

const listingCount = directoryData.length;

// make a copy of directoryData and reformat it to be a GeoJSON object
const geoJsonData = directoryData.map((item: Listing) => {
  return {
    type: 'Feature',
    geometry: {
      type: 'Point',
      coordinates: [Number(item.latLong.split(',')[1]), Number(item.latLong.split(',')[0])]
    },
    properties: {
      name: item.name,
      type: item.type,
      description: item.description,
      address: item.address,
      website: item.website,
      instagram: item.instagram,
      phone: item.phone,
      mapUrl: item.mapUrl,
    }
  }
});
---

<div id="directory-container" class="directory-container" data-directory-data={JSON.stringify(geoJsonData)}>

  <div class="filters">
    <div>{listingCount} listings</div>
    <div>
      <input type="text" placeholder="Search by Name, Location, or Type" />
    </div>
  </div>

  <div class="map-container">
    <div id="map"></div>
  </div>

  <ul class="directory-list" role="list">
    {directoryData.map((item: Listing) => (
      <li class="directory-list-item">
        <h3 class="type-step-2">{item.name}</h3>
        {item.type && <div class="type-step--1">{item.type}</div>}
        <div class="directory-list-item-content">
          {item.description && <div>{item.description}</div>}
          {item.address && <div><a href={item.mapUrl} target="_blank">{item.address}</a></div>}
          {item.phone && <div>{item.phone}</div>}
          {item.website && <div><a href={item.website} target="_blank" aria-label="Visit {item.name}'s website">Website</a></div>}
          {item.instagram && <div><a href={item.instagram} target="_blank" aria-label="Visit {item.name}'s Instagram">Instagram</a></div>}
        </div>
      </li>
    ))}
  </ul>

</div>

<script>
  import {Map, setWorkerUrl, GeolocateControl, Popup, NavigationControl} from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';
  import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';
  import styleUrl from '../assets/map-theme.json';

  setWorkerUrl(workerUrl);

  const directoryData = JSON.parse(document.getElementById('directory-container')?.dataset.directoryData || '[]');

  await document.fonts.load("16px 'Ginza Loop'");

  const map = new Map({
      container: 'map', // container id
      style: styleUrl, // style URL
      center: [-98.5, 39.8], // starting position [lng, lat]
      zoom: 3 // starting zoom
  });

  map.on('load', () => {
      map.addSource('spookySpots', {
          'type': 'geojson',
          'data': {
            'type': 'FeatureCollection',
            'features': directoryData
          }
      });
      map.addLayer({
        'id': 'spookySpots',
        'type': 'circle',
        'source': 'spookySpots',
        'paint': {
          'circle-radius': 8,
          'circle-color': '#DD6319'
        }
      });
  });

  // Add geolocate control to the map.
  map.addControl(
    new GeolocateControl({
      positionOptions: {
        enableHighAccuracy: true
      },
      trackUserLocation: true
    })
  );

  // Add zoom and rotation controls to the map.
  map.addControl(new NavigationControl({
    visualizePitch: true,
    visualizeRoll: true,
    showZoom: true,
    showCompass: true
  }));

  // When a click event occurs on a feature in the spookySpots layer, open a popup at the
  // location of the feature, with description HTML from its properties.
  map.on('click', 'spookySpots', (e) => {
      const coordinates = e.features[0].geometry.coordinates.slice();
      const popupContent = `
        <div class="type-step-0">${e.features[0].properties.name}</div>
        <div class="font-mono type-step--1">
        <div>${e.features[0].properties.type}</div>
        <div>${e.features[0].properties.description}</div>
        <div><a href="${e.features[0].properties.mapUrl}" target="_blank">${e.features[0].properties.address}</a></div>
        <div>${e.features[0].properties.phone}</div>
        <div><a href="${e.features[0].properties.website}" target="_blank">Website</a></div>
        <div><a href="${e.features[0].properties.instagram}" target="_blank">Instagram</a></div>
        </div>
      `;

      // Ensure that if the map is zoomed out such that multiple
      // copies of the feature are visible, the popup appears
      // over the copy being pointed to.
      while (Math.abs(e.lngLat.lng - coordinates[0]) > 180) {
        coordinates[0] += e.lngLat.lng > coordinates[0] ? 360 : -360;
      }

      new Popup()
        .setLngLat(coordinates)
        .setHTML(popupContent)
        .addTo(map);
  });

  // Change the cursor to a pointer when the mouse is over the places layer.
  map.on('mouseenter', 'places', () => {
    map.getCanvas().style.cursor = 'pointer';
  });

  // Change it back to a pointer when it leaves.
  map.on('mouseleave', 'places', () => {
    map.getCanvas().style.cursor = '';
  })
</script>

<style is:global>
  .directory-container {
    display: grid;
    align-items: start;
    gap: var(--space-l);
    margin-block: var(--space-l);

    @media screen and (min-width: 768px) {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Filters */
  .filters {
    top: 0;
    z-index: 10;
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    position: sticky;
    gap: var(--space-s);
    grid-column: 1 / -1;
    padding-block: var(--space-s);
    background-color: var(--color-bg-primary);
  }

  /* Directory List */
  .directory-list {
    padding: 0;
    margin: 0;
    list-style: none;

    .directory-list-item {
      padding-block: var(--space-xs);
      border-top: 1px solid var(--color-fg-primary);

      &:last-child {
        border-bottom: 1px solid var(--color-fg-primary);
      }

      h3 {
        margin: 0;
      }

      .directory-list-item-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        margin-top: var(--space-2xs);
      }
    }
  }

  /* Map */
  .map-container {
    height: 500px;
    position: relative;

    @media screen and (min-width: 768px) {
      order: 2;
      position: sticky;
      top: calc(var(--space-l) * 2);
      height: calc(100vh - (var(--space-l) * 3));
    }
  }

  #map {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--space-3xs);
    
    &.maplibregl-map {
      font-family: var(--font-sans);
    }
  
    .maplibregl-popup-content {
      color: var(--color-bg-primary);
    }
  }

</style>