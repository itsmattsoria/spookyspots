---
import { fetchListings } from '../scripts/fetch-listings';
import type { Listing } from '../schemas/listing';
import { typeColors } from '../schemas/typeColors';
import Carousel from './Carousel.astro';
import CloseIcon from '../assets/close.svg';
import CaratIcon from '../assets/carat.svg';
import PinIcon from '../assets/pin.svg';
import StarIcon from '../assets/star-full.svg';
import StarRemoveIcon from '../assets/star-remove.svg';

let directoryData = null;
let errorMessage = null;

try  {
	directoryData = await fetchListings();
} catch (err: any) {
	errorMessage = err.message;
  console.error(err);
}

const listingCount = directoryData?.length;

// Helper to normalize the id for each item
const makeId = (item: Listing) =>
[item.name, item.type, item.address, item.tags, item.searchTerms]
  .map(v => (v ?? '').toLowerCase())
  .join(' ')
  .replace(/\s+/g, ' ')// collapse any accidental double spaces
  .trim();

// make a copy of directoryData and reformat it to be a GeoJSON object
const geoJsonData = directoryData?.map((item: Listing) => {
  return {
    type: 'Feature',
    geometry: {
      type: 'Point',
      coordinates: [Number(item.latLong.split(',')[1]), Number(item.latLong.split(',')[0])]
    },
    properties: {
      id: makeId(item),
      name: item.name,
      type: item.type.toLowerCase(),
      description: item.description,
      address: item.address,
      website: item.website,
      instagram: item.instagram,
      phone: item.phone,
      mapUrl: item.mapUrl,
      color: typeColors.find((type) => type.name === item.type)?.color || '#F78148',
      tags: item.tags,
      rating: item.rating,
      userRatingCount: item.userRatingCount,
      searchTerms: item.searchTerms.toLowerCase()
    }
  }
});

// Get all unique types, and their count
const uniqueTypes: { name: string, count: number }[] = [];
const uniqueTags: { name: string, count: number }[] = [];
directoryData?.forEach((item: Listing) => {
  // Get the types
  const type = uniqueTypes.find((type) => type.name.toLowerCase() === item.type.toLowerCase());
  if (type) {
    type.count++;
  } else {
    uniqueTypes.push({ name: item.type.toLowerCase(), count: 1 });
  }

  // Get the tags
  const tags = item?.tags?.split(',').map(tag => tag.trim());
  tags?.forEach((tagItem) => {
    const tag = uniqueTags.find((tag) => tag.name === tagItem);
    if (tag) {
      tag.count++;
    } else {
      uniqueTags.push({ name: tagItem, count: 1 });
    }
  });

  // Get the photos and add them to item.photos[]
  item.photos = [item.photo1, item.photo2, item.photo3].filter(Boolean);
});
uniqueTypes.sort((a, b) => b.count - a.count);
uniqueTags.sort((a, b) => a.name.localeCompare(b.name));

// resort directoryData alphabetically by name
const sortedDirectoryData = directoryData?.sort((a: Listing, b: Listing) => a.name.localeCompare(b.name));
---

<div id="directory-container" class="directory-container" data-directory-data={JSON.stringify(geoJsonData)}>
  <div class="directory-inner">
    <div id="filters" class="filters site-padding">
      <div class="filters-wrapper">
        <div class="input-wrap">
          <label for="search">Search</label>
          <div class="search-input-wrap">
            <input id="search" type="text" placeholder="City, name, type, tag, etc." class="fuzzy-search search-input" />
            <button id="clearBtn" class="clear-btn" aria-label="Clear search" tabindex="-1"><CloseIcon /></button>
          </div>
        </div>
        
        <div class="input-wrap">
          <label for="type-filter">Filter by type</label>
          <div class="select-wrap">
            <select id="type-filter">
              <button>
                <selectedcontent></selectedcontent>
              </button>
              <option value="" class="option-all">
                <span class="option-icon" aria-hidden="true"></span>
                <span class="option-label">All</span>
              </option>
              {uniqueTypes.map((type) => <option value={type.name} style={`--option-color: ${typeColors.find((color) => color.name.toLowerCase() === type.name.toLowerCase())?.color || '#f5efe0'};`}><span class="option-icon" aria-hidden="true"></span><span class="option-label">{type.name} ({type.count})</span></option>)}
            </select>
          </div>
        </div>
  
        <div class="input-wrap">
          <label for="tags-filter">Filter by tags</label>
          <select id="tags-filter" multiple="multiple" class="multiple-select" placeholder="Select tags" data-facet="tags">
            {uniqueTags.map((tag) => tag.name !== '' && <option value={tag.name}>{tag.name} ({tag.count})</option>)}
          </select>
        </div>
  
        <div>
          <button id="clearAllFilters" class="clear-filters-btn hidden" aria-hidden="true">
            <CloseIcon />
            <span>Clear filters</span>
          </button>
        </div>
      </div>
      <div class="font-mono type-step--2"><span id="listing-count">{listingCount}</span> <span id="listing-count-text">spooky spots</span></div>
    </div>
  
    <div class="directory-bottom">
      <div class="map-container">
        <div id="map">
          <div id="zoom-msg" class="zoom-msg">
            <div class="zoom-msg-content">
              <span>Use ctrl + scroll, or "pinch" to zoom the map</span>
              <button id="zoom-msg-dismiss" class="zoom-msg-dismiss tag" aria-label="Dismiss zoom message">
                <CloseIcon />
              </button>
            </div>
          </div>
        </div>
      </div>
    
      <div class="directory-list-wrapper">
        <ul id="directory-list" class="directory-list list" role="list">
          {sortedDirectoryData?.map((item: Listing, index: number) => (
            <li class="directory-list-item" data-index={index} data-type={item.type.toLowerCase()} data-location={item.address.toLowerCase()} data-tags={item.tags} data-searchterms={item.searchTerms?.toLowerCase()} data-id={makeId(item)}>
              <details>
                <summary>
                  <div class="directory-list-item-header">
                    <div class="type-step-0 name">
                      <span style={`color: ${typeColors.find((color) => color.name === item.type)?.color || '#F78148'}`}>{item.name}</span>
                      <div class="favorite-icon color-warning">
                        <StarIcon />
                        <span class="sr-only">User Favorite</span>
                      </div>
                    </div>
                   <div class="type-step--1">
                    <span style={`color: ${typeColors.find((color) => color.name === item.type)?.color || '#F78148'}`}>{item.type}</span> {item.address && <button class="directory-list-item-map-link link-button font-mono">{item.addressShort} <span><PinIcon /></span></button>}
                   </div>
                  </div>
                  <div>
                    <div class="tag tag--square summary-icon">
                      <CaratIcon />
                    </div>
                  </div>
                </summary>
                <div class="directory-list-item-content">
                  {item.rating && (
                    <div>
                      <p class="type-step--1"><span class="color-warning icon"><StarIcon /></span> <span>{item.rating.toFixed(1)}</span>
                        {item.userRatingCount && <span> ({item.userRatingCount.toLocaleString('en-US')} reviews)</span>}
                      </p>
                    </div>
                  )}
                  {item.description && <div>{item.description}</div>}
                  {item.photos?.length > 0 && <div class="photos"><Carousel photos={item.photos} item={item} /></div>}
                  {item.tags && <div class="tags">{item.tags.split(', ').map((tag) => <span class="tag tag--secondary">#{tag}</span>)}</div>}
                  <div>
                    <a href={item.mapUrl} target="_blank" class="font-mono type-step--2">{item.address}<span class="external-icon">↗</span></a>
                  </div>
                  <div class="font-mono type-step--2">
                    {item.website && <a href={item.website} target="_blank" aria-label="Visit {item.name}'s website">Website</a>}{item.website && (item.instagram || item.phone) && <span> | </span>}
                    {item.instagram && <a href={item.instagram} target="_blank" aria-label="Visit {item.name}'s Instagram">Instagram</a>}{item.instagram && item.phone && <span> | </span>}{item.phone && <a href={'tel:' + item.phone}>{item.phone}</a>}
                  </div>
                  <div>
                    <button class="add-to-favorites tag tag--lg">
                      <span>
                        <StarIcon />
                      </span>
                      <span>Add to favorites</span>
                    </button>

                    <button class="remove-from-favorites tag tag--lg bg-accent" aria-hidden="true">
                      <span>
                        <StarRemoveIcon />
                      </span>
                      <span>Remove from favorites</span>
                    </button>
                  </div>
                  <div>
                    <a href={`mailto:hellospoookybiz@gmail.com?subject=Spooky Spots: Change Report for ${item.name} (${item.addressShort})`} class="color-warning type-step--2">Report a change to this spot</a>
                  </div>
                </div>
              </details>
            </li>
          ))}
        </ul>
      
        <div id="empty-state" class="empty-state" style="display: none;">
          <p><span class="font-display type-step-4 distortion-filter">Boo!</span><br> Sorry, but we didn't find any spooky spots that match your search. Try again with different filters.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import {Map, setWorkerUrl, GeolocateControl, Popup, NavigationControl, LngLatBounds} from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';
  import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';
  import styleUrl from '../assets/map-theme.json';
  import List from 'list.js';
  import { type MultipleSelectInstance, multipleSelect } from 'multiple-select-vanilla';
  import 'multiple-select-vanilla/dist/styles/css/multiple-select.css';
  const directoryContainer = document.getElementById('directory-container');
  const mapInitialCenter: [number, number] = [0, 0];
  const mapInitialZoom = 1;
  const mapCircleRadius = 7;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  setWorkerUrl(workerUrl);

  const directoryData = JSON.parse(document.getElementById('directory-container')?.dataset.directoryData || '[]');

  // await document.fonts.load("16px 'Ginza Loop'");

  const map = new Map({
      container: 'map', // container id
      style: styleUrl, // style URL
      center: mapInitialCenter, // starting position [lng, lat]
      zoom: mapInitialZoom // starting zoom
  });

  // Disable mouse wheel scrolling soom, but keep pinch-to-zoom enabled
  const zoomMsg = document.getElementById('zoom-msg');
  const zoomMsgDismiss = document.getElementById('zoom-msg-dismiss');
  let zoomMsgDismissed = false;
  let zoomMsgTimeout;

  map.getCanvasContainer().addEventListener('wheel', (e) => {
    if (!e.ctrlKey) {
      // Display the scroll message when a wheel event is detected
      if (!zoomMsgDismissed) {
        zoomMsg.style.display = 'block';

        clearTimeout(zoomMsgTimeout);
        zoomMsgTimeout = setTimeout(() => {
          zoomMsg.style.display = 'none';
        }, 2000);
      }
      
      // Stop standard mouse-wheel scrolling from reaching MapLibre
      e.stopPropagation();
    }
  }, { capture: true, passive: false });

  zoomMsgDismiss?.addEventListener('click', () => {
    zoomMsgDismissed = true;
    zoomMsg.style.display = 'none';
  });

  const layerIDs: Array<string> = [];

  map.on('load', () => {
    map.addSource('spookySpots', {
        'type': 'geojson',
        'data': {
          'type': 'FeatureCollection',
          'features': directoryData
        }
    });

    directoryData.forEach((feature) => {
      const name = feature.properties.name;
      const type = feature.properties.type;
      const address = feature.properties.address;
      const tags = feature.properties.tags;
      const searchTerms = feature.properties.searchTerms;
      const layerID = feature.properties.id;

      // Add a layer for this symbol type if it hasn't been added already.
      if (!map.getLayer(layerID)) {
        map.addLayer({
          'id': layerID,
          'type': 'circle',
          'source': 'spookySpots',
          'paint': {
            'circle-radius': mapCircleRadius,
            'circle-color': ['get', 'color'],
          },
          // use filter to only show the features that match the search value
          'filter': ['all', ['==', ['get', 'name'], name], ['==', ['get', 'type'], type], ['==', ['get', 'address'], address], ['==', ['get', 'tags'], tags], ['==', ['get', 'searchTerms'], searchTerms]]
        });

        layerIDs.push(layerID);

        map.on('click', layerID, (e) => {
          // Extract the coordinate where the user clicked
          const coordinates = e.lngLat;

          showPopup(coordinates, e.features[0]);
        });

        // 3. Optional: Change the cursor to a pointer when hovering over the layer
        map.on('mouseenter', layerID, () => {
          map.getCanvas().style.cursor = 'pointer';
          map.setPaintProperty(layerID, 'circle-radius', 15);
          map.setPaintProperty(layerID, 'circle-stroke-width', 3);
          map.setPaintProperty(layerID, 'circle-stroke-color', '#f5efe0');
        });

        // 4. Optional: Reset the cursor when leaving the layer
        map.on('mouseleave', layerID, () => {
          map.getCanvas().style.cursor = '';
          map.setPaintProperty(layerID, 'circle-radius', mapCircleRadius);
          map.setPaintProperty(layerID, 'circle-stroke-width', 0);
          map.setPaintProperty(layerID, 'circle-stroke-color', 'transparent');
        });
      }
    });
  });

  // Show a layer popup
  function showPopup(coordinates: string, feature: any) {
    const popupContent = `
      <div class="popup-title font-sans type-step-0">${feature.properties.name}</div>
      <div><span class="tag" style="--tag-color: ${feature.properties.color}">${feature.properties.type}</span></div>
      <div>
        ${feature.properties.rating != null
          ? `<span class="color-warning icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.0006 18.26L4.94715 22.2082L6.52248 14.2799L0.587891 8.7918L8.61493 7.84006L12.0006 0.5L15.3862 7.84006L23.4132 8.7918L17.4787 14.2799L19.054 22.2082L12.0006 18.26Z"></path></svg></span>
              <span>${feature.properties.rating.toFixed(1)}</span>`
          : ''}
        ${feature.properties.userRatingCount != null
          ? `<span> (${feature.properties.userRatingCount.toLocaleString('en-US')} reviews)</span>`
          : ''}
      </div>
      <div><a href="${feature.properties.mapUrl}" target="_blank">${feature.properties.address}<span class="external-icon">↗</span></a></div>
      <div>${feature.properties.phone}</div>
      <div><a href="${feature.properties.website}" target="_blank">Website</a> | <a href="${feature.properties.instagram}" target="_blank">Instagram</a></div>
      <div>
        <button class="tag tag--lg" data-popup-info-link data-popup-info-link-feature="${feature.properties.id}"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22ZM11 11V17H13V11H11ZM11 7V9H13V7H11Z"></path></svg><span>More info</span></button>
      </div>
    `;

    // 2. Create and render the popup
    new Popup()
      .setLngLat(coordinates)
      .setHTML(popupContent)
      .addTo(map);
  }

  // Create a listener for each of the popup info links
  const popupInfoLinks = document.querySelectorAll<HTMLButtonElement>('[data-popup-info-link]');
  popupInfoLinks.forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      console.log('popup info link clicked');
      const target = e.target as HTMLButtonElement;
      const feature = target.dataset.popupInfoLinkFeature;
      const featureElement = document.querySelector<HTMLElement>(`[data-id="${feature}"]`);
      // scroll to the feature element
      featureElement?.scrollIntoView({ behavior: "smooth", block: "start" });
      const fetureElementSummary = featureElement?.querySelector<HTMLElement>('summary');
      fetureElementSummary?.click();
    });
  });

  const mapContainer = document.querySelector<HTMLElement>('.map-container');

  mapContainer?.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLButtonElement>(
      '[data-popup-info-link]'
    );
    if (!link || !mapContainer.contains(link)) return;

    const feature = link.dataset.popupInfoLinkFeature;
    const featureElement = document.querySelector<HTMLElement>(`[data-id="${feature}"]`);
    // scroll to the feature element
    featureElement?.scrollIntoView({ block: "start" });
    const fetureElementSummary = featureElement?.querySelector<HTMLElement>('summary');
    fetureElementSummary?.click();
  });
  
  // Add geolocate control to the map.
  map.addControl(
    new GeolocateControl({
      positionOptions: {
        enableHighAccuracy: true
      },
      trackUserLocation: true
    })
  );

  // Add zoom and rotation controls to the map.
  map.addControl(new NavigationControl({
    showZoom: true,
    showCompass: true
  }));

  // Add a custom button to allow user to expand map
  class MapButtonControl {
    onAdd(map) {
      this._map = map;
      this._container = document.createElement('div');
      this._container.className = 'maplibregl-ctrl maplibregl-ctrl-group';

      const button = document.createElement('button');
      button.type = 'button';
      button.title = 'Expand map';
      button.className = 'maplibregl-ctrl-expand';
      button.innerHTML = '<span class="maplibregl-ctrl-icon" aria-hidden="true"></span>';

      button.onclick = () => {
        toggleMapExpansion();
      };

      this._container.appendChild(button);
      return this._container;
    }

    onRemove() {
      this._container.remove();
      this._map = undefined;
    }
  }

  // Add the custom control to the map
  map.addControl(new MapButtonControl(), 'top-left');

  function toggleMapExpansion() {
    if (directoryContainer?.classList.contains('map-full')) {
      directoryContainer?.classList.remove('map-full');
    } else {
      directoryContainer?.classList.add('map-full');
    }
  }

  // List.js functionality for search, sort, and filter
  const listingCount = document.getElementById('listing-count');
  const listingCountText = document.getElementById('listing-count-text');
  const emptyState = document.getElementById('empty-state');
  const directoryListItems = document.querySelectorAll('.directory-list-item');
  const directoryList = new List('directory-container', {
    valueNames: [
      'name',
      'favorite',
      { data: ['location'] },
      { data: ['type'] },
      { data: ['tags'] },
      { data: ['searchterms'] },
      { data: ['id'] }
    ],
    fuzzySearch: {
      location: 0,
      distance: 200,
      threshold: 0.7,
      multiSearch: true
    }
  });

  directoryList.on('updated', () => {
    const listingLength = directoryList.matchingItems.length;
    listingCount.textContent = listingLength.toString();
    listingCountText.textContent = listingLength === 1 ? 'spooky spot' : 'spooky spots';
    if (listingLength === 0) {
      emptyState.style.display = 'block';
    } else {
      emptyState.style.display = 'none';
    }
  });

  directoryListItems?.forEach((item) => {
    const layerId = item.getAttribute('data-id');

    item.addEventListener('mouseenter', () => {
      if (!map.getLayer(layerId)) return;
      map.moveLayer(layerId);
      map.setPaintProperty(layerId, 'circle-radius', 15);
      map.setPaintProperty(layerId, 'circle-stroke-width', 3);
      map.setPaintProperty(layerId, 'circle-stroke-color', '#f5efe0');
    });

    item.addEventListener('mouseleave', () => {
      if (!map.getLayer(layerId)) return;
      map.setPaintProperty(layerId, 'circle-radius', mapCircleRadius);
      map.setPaintProperty(layerId, 'circle-stroke-width', 0);
      map.setPaintProperty(layerId, 'circle-stroke-color', 'transparent');
    });

    item.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      if (target.closest('details:not([open]) summary')) {
        const parentDetails = target.closest('details');
        parentDetails?.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      if (target.closest('.directory-list-item-map-link')) {
        const feature = directoryData.find((feature) => feature.properties.id === layerId);
        const bounds = new LngLatBounds();
        bounds.extend(feature.geometry.coordinates);
        map.fitBounds(bounds, {
          padding: 100,
          maxZoom: 12,
          linear: prefersReducedMotion,
          speed: prefersReducedMotion ? 0 : 1.2
        });
        // close all open popups first
        document.querySelectorAll('.maplibregl-popup-close-button').forEach(button => button.click());
        // then show the popup
        showPopup(feature.geometry.coordinates, feature);
      }
    });
  });

  // Filtering functionality
  const clearAllFilters = document.getElementById('clearAllFilters');
  const filterState = {
    search: '',
    type: '',
    // Each Multiple Select Vanilla instance registers its own facet key here,
    // e.g. { tags: [...], neighborhood: [...] }
    facets: {} as Record<string, string[]>
  }

  clearAllFilters?.addEventListener('click', () => {
    resetFilters();
  });

  const typeFilter = document.getElementById('type-filter');
  typeFilter?.addEventListener('change', function() {
    const selectedType = this.value;
    filterState.type = selectedType;
    applyFilters();
  });

  // Multiple select functionality
  // Each instance controls its own facet, identified by the element's `data-facet`.
  // Facets are matched generically against a matching `data-<facet>` on each list item
  // and `feature.properties[<facet>]` on the map data.
  const multiSelectInstances: MultipleSelectInstance[] = [];
  const multipleSelectElements = document.querySelectorAll<HTMLSelectElement>('.multiple-select');

  multipleSelectElements.forEach((filterElement) => {
    const facet = filterElement.dataset.facet;
    if (!facet) return; // skip any multiselect that hasn't declared a facet

    // Initialize this facet's state
    filterState.facets[facet] = [];

    const instance = multipleSelect(filterElement, {
      maxHeight: 200,
      filter: true,
      showClear: true,
      showSearchClear: true,
      selectAll: false,
      onChange: () => {
        filterState.facets[facet] = instance.getSelects('value') as string[];
        applyFilters();
      }
    }) as MultipleSelectInstance;

    multiSelectInstances.push(instance);
  });


  // Filter the sources in the map when the search input changes
  const searchInput = document.getElementById('search');
  const clearBtn = document.getElementById('clearBtn');

  // Toggle button visibility based on text existence
  function toggleClearBtn() {
    if (searchInput?.value.length > 0) {
      clearBtn.removeAttribute('hidden');
      clearBtn.style.opacity = '1';
      clearBtn.style.pointerEvents = 'auto';
      clearBtn.removeAttribute('tabindex');
    } else {
      clearBtn.setAttribute('hidden', '');
      clearBtn.setAttribute('tabindex', '-1');
    }
  }

  // Clear input field on button click
  clearBtn.addEventListener('click', () => {
    searchInput.value = '';
    filterState.search = '';
    toggleClearBtn();
    applyFilters();
    searchInput.focus();
  });

  searchInput?.addEventListener('keyup', (e: Event) => {
    toggleClearBtn();

    const value = e.target.value.trim().toLowerCase();
    filterState.search = value;
    applyFilters();
  });

  // Apply filters to the map and list
  function applyFilters() {
    const flattenedFilterState = [
      filterState.search,
      filterState.type,
      filterState.favorites,
      ...Object.values(filterState.facets).flat()
    ].join(' ').trim();

    if (flattenedFilterState === '') {
      directoryList.search();
      directoryList.filter();
      // reorder the directory list for favorites
      checkFavorites();
      layerIDs.forEach((layerID) => {
        map.setLayoutProperty(
          layerID,
          'visibility',
          'visible'
        );
      });
      hideClearAllFilters();
    } else {
      // true only if every active facet matches this item/feature
      const matchesAllFacets = (getValue: (facet: string) => string) =>
        Object.entries(filterState.facets).every(([facet, selected]) =>
          selected.every(val => (getValue(facet) || '').includes(val))
        );

      directoryList.filter(function(item) {
        const matchesSearch = item.values().id.toLowerCase().includes(filterState.search);
        const matchesType = filterState.type === '' || item.values().type === filterState.type;
        const matchesFacets = matchesAllFacets(facet => item.values()[facet]);

        return matchesSearch && matchesType && matchesFacets;
      });

      directoryData.forEach((feature) => {
        const matchesSearch = feature.properties.id.includes(filterState.search);
        const matchesType = filterState.type === '' || feature.properties.type === filterState.type;
        const matchesFacets = matchesAllFacets(facet => feature.properties[facet]);

        map.setLayoutProperty(
          feature.properties.id,
          'visibility',
          matchesSearch && matchesType && matchesFacets ? 'visible' : 'none'
        );
      });

      showClearAllFilters();
    }

    directoryContainer?.scrollIntoView({ behavior: "smooth", block: "start" });
    recenterMap();
  }

  // Recenter the map based on visible layers
  function recenterMap() {
    const visibleLayers = layerIDs.filter((layerID) => map.getLayoutProperty(layerID, 'visibility') === 'visible');
    const visibleSet = new Set(visibleLayers);
    const visibleFeatures = directoryData.filter(feature => visibleSet.has(feature.properties.id));

    if (visibleFeatures.length < layerIDs.length) {
      const bounds = new LngLatBounds();
      visibleFeatures.forEach((feature) => {
        bounds.extend(feature.geometry.coordinates);
      });
      map.fitBounds(bounds, {
        padding: 100,
        maxZoom: 12,
        linear: prefersReducedMotion,
        speed: prefersReducedMotion ? 0 : 1.2
      });
    } else {
      // recenter map when all layers are visible
      map.setCenter(mapInitialCenter);
      map.setZoom(mapInitialZoom);
    }
  }

  function resetFilters() {
    searchInput.value = '';
    typeFilter.value = '';

    filterState.search = '';
    filterState.type = '';
    Object.keys(filterState.facets).forEach((facet) => {
      filterState.facets[facet] = [];
    });

    // Uncheck every Multiple Select Vanilla instance
    multiSelectInstances.forEach((instance) => {
      instance.uncheckAll();
    });

    applyFilters();
    toggleClearBtn();
  }

  function showClearAllFilters() {
    clearAllFilters?.classList.remove('hidden');
    clearAllFilters?.setAttribute('aria-hidden', 'false');
  }

  function hideClearAllFilters() {
    clearAllFilters?.classList.add('hidden');
    clearAllFilters?.setAttribute('aria-hidden', 'true');
  }

  /* Favorites functionality */
  const directoryListElement = document.getElementById('directory-list');
  const addToFavoritesButtons = document.querySelectorAll('.add-to-favorites');
  const removeFromFavoritesButtons = document.querySelectorAll('.remove-from-favorites');
  addToFavoritesButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const item = button.closest('.directory-list-item');
      const itemId = item.getAttribute('data-id');
      addToFavorites(itemId);
    });
  });

  removeFromFavoritesButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const item = button.closest('.directory-list-item');
      const itemId = item.getAttribute('data-id');
      removeFromFavorites(itemId, item);
    });
  });

  let favorites: any[] = [];
  function checkFavorites() {
    if (localStorage.getItem('favorites') !== null) {
      favorites = JSON.parse(localStorage.getItem('favorites'));

      if (favorites) {
        // move the favorites to the top of the list, and add 'favorite' class to the list items
        favorites.forEach((favorite) => {
          const item = document.querySelector(`[data-id="${favorite}"]`);
          if (item) {
            item.classList.add('favorite');
            item.querySelector('.add-to-favorites')?.setAttribute('aira-hidden', 'true');
            item.querySelector('.remove-from-favorites')?.removeAttribute('aria-hidden');
          }

          // remove the item from the list and move it to the top of the list
          directoryListElement?.prepend(item);
        });
      }
    }
  }
  /* Check on page load */
  checkFavorites();

  function addToFavorites(item: any) {
    favorites.push(item);
    localStorage.setItem('favorites', JSON.stringify(favorites));
    checkFavorites();
    directoryListElement?.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function removeFromFavorites(itemId: string, item: any) {
    favorites = favorites.filter((favorite) => favorite !== itemId);
    localStorage.setItem('favorites', JSON.stringify(favorites));
    item.classList.remove('favorite');
    // put the item back in its original position in the directory list based on its data-index value
    const index = item.getAttribute('data-index');
    directoryListElement?.children[index].appendChild(item);
    checkFavorites();
  }
</script>

