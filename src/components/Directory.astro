---
const { directoryData } = Astro.props;
import type { Listing } from '../schemas/listing';
import { typeColors } from '../schemas/typeColors';

const listingCount = directoryData.length;

// make a copy of directoryData and reformat it to be a GeoJSON object
const geoJsonData = directoryData.map((item: Listing) => {
  return {
    type: 'Feature',
    geometry: {
      type: 'Point',
      coordinates: [Number(item.latLong.split(',')[1]), Number(item.latLong.split(',')[0])]
    },
    properties: {
      name: item.name,
      type: item.type.toLowerCase(),
      description: item.description,
      address: item.address,
      website: item.website,
      instagram: item.instagram,
      phone: item.phone,
      mapUrl: item.mapUrl,
      color: typeColors.find((type) => type.name === item.type)?.color || '#F78148',
      tags: item.tags?.toLowerCase()
    }
  }
});

// resort directoryData alphabetically by name
const sortedDirectoryData = directoryData.sort((a: Listing, b: Listing) => a.name.localeCompare(b.name));
---

<div id="directory-container" class="directory-container" data-directory-data={JSON.stringify(geoJsonData)}>

  <div class="filters">
    <div class="filters-wrapper">
      <div>
        <label for="search">Search</label>
        <input id="search" type="text" placeholder="Search by Name, Location, or Type" class="fuzzy-search search-input" />
      </div>
      
      <div>
        <label for="type-filter">Filter by type</label>
        <select id="type-filter">
          <option value="all">All</option>
          <option value="store">Store</option>
          <option value="coffee shop">Coffee Shop</option>
          <option value="restaurant">Restaurant</option>
          <option value="bar">Bar</option>
          <option value="gallery">Gallery</option>
          <option value="other">Other</option>
        </select>
      </div>
    </div>
    <div>{listingCount} spooky spots</div>
  </div>

  <div class="map-container">
    <div id="map"></div>
  </div>

  <ul id="directory-list" class="directory-list list" role="list">
    {sortedDirectoryData.map((item: Listing) => (
      <li class="directory-list-item" data-type={item.type.toLowerCase()}>
        <details>
          <summary>
            <div class="directory-list-item-header">
              <div class="type-step-1 name" style={`color: ${typeColors.find((color) => color.name === item.type)?.color || '#F78148'}`}>{item.name}</div>
             <div class="type-step--1">
              <span style={`color: ${typeColors.find((color) => color.name === item.type)?.color || '#F78148'}`}>{item.type}</span> - {item.address && <a href={item.mapUrl} target="_blank" class="location">{item.address}</a>}
             </div>
            </div>
            <div>
              <div class="tag summary-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 15.0006L7.75732 10.758L9.17154 9.34375L12 12.1722L14.8284 9.34375L16.2426 10.758L12 15.0006Z"></path></svg>
              </div>
            </div>
          </summary>
          <div class="directory-list-item-content">
            {item.description && <div>{item.description}</div>}
            {item.phone && <div>{item.phone}</div>}
            <div>
              {item.website && <a href={item.website} target="_blank" aria-label="Visit {item.name}'s website">Website</a>}{item.instagram && <span> | </span>}{item.instagram && <a href={item.instagram} target="_blank" aria-label="Visit {item.name}'s Instagram">Instagram</a>}
            </div>
            <div>
              <a href={`mailto:matt.soria@hey.com?subject=Spooky Spots:Change Report for ${item.name}`} class="color-warning">Report a change to this spot</a>
            </div>
          </div>
        </details>
      </li>
    ))}
  </ul>

</div>

<script>
  import {Map, setWorkerUrl, GeolocateControl, Popup, NavigationControl, LngLatBounds} from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';
  import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';
  import styleUrl from '../assets/map-theme.json';
  import List from 'list.js';

  setWorkerUrl(workerUrl);

  const directoryData = JSON.parse(document.getElementById('directory-container')?.dataset.directoryData || '[]');

  await document.fonts.load("16px 'Ginza Loop'");

  const map = new Map({
      container: 'map', // container id
      style: styleUrl, // style URL
      center: [-98.5, 39.8], // starting position [lng, lat]
      zoom: 3 // starting zoom
  });

  const layerIDs: Array<string> = [];

  map.on('load', () => {
    map.addSource('spookySpots', {
        'type': 'geojson',
        'data': {
          'type': 'FeatureCollection',
          'features': directoryData
        }
    });

    directoryData.forEach((feature) => {
      const name = feature.properties.name;
      const type = feature.properties.type;
      const address = feature.properties.address;
      const tags = feature.properties.tags;
      const layerID = feature.properties.name.toLowerCase() + ' ' + feature.properties.type.toLowerCase() + ' ' + feature.properties.address.toLowerCase() + ' ' + feature.properties.tags?.toLowerCase();

      // Add a layer for this symbol type if it hasn't been added already.
      if (!map.getLayer(layerID)) {
        map.addLayer({
          'id': layerID,
          'type': 'circle',
          'source': 'spookySpots',
          'paint': {
            'circle-radius': 8,
            'circle-color': ['get', 'color'],
          },
          // use filter to only show the features that match the search value
          'filter': ['all', ['==', ['get', 'name'], name], ['==', ['get', 'type'], type], ['==', ['get', 'address'], address], ['==', ['get', 'tags'], tags]]
        });

        layerIDs.push(layerID);

        map.on('click', layerID, (e) => {
          // Extract the coordinate where the user clicked
          const coordinates = e.lngLat;

          const popupContent = `
            <div class="font-sans type-step-0">${e.features[0].properties.name}</div>
            <div><span class="tag" style="--tag-color: ${e.features[0].properties.color}">${e.features[0].properties.type}</span></div>
            <div><a href="${e.features[0].properties.mapUrl}" target="_blank">${e.features[0].properties.address}</a></div>
            <div>${e.features[0].properties.phone}</div>
            <div><a href="${e.features[0].properties.website}" target="_blank">Website</a></div>
            <div><a href="${e.features[0].properties.instagram}" target="_blank">Instagram</a></div>
          `;

          // 2. Create and render the popup
          new Popup()
            .setLngLat(coordinates)
            .setHTML(popupContent)
            .addTo(map);
        });

        // 3. Optional: Change the cursor to a pointer when hovering over the layer
        map.on('mouseenter', layerID, () => {
          map.getCanvas().style.cursor = 'pointer';
        });

        // 4. Optional: Reset the cursor when leaving the layer
        map.on('mouseleave', layerID, () => {
          map.getCanvas().style.cursor = '';
        });
      }
    });
  });

  // Add geolocate control to the map.
  map.addControl(
    new GeolocateControl({
      positionOptions: {
        enableHighAccuracy: true
      },
      trackUserLocation: true
    })
  );

  // Add zoom and rotation controls to the map.
  map.addControl(new NavigationControl({
    showZoom: true,
    showCompass: true
  }));

  // List.js functionality for search, sort, and filter
  const directoryList = new List('directory-container', {
    valueNames: [
      'name', 
      'location', 
      { data: ['type'] }
    ],
  });

  // Filtering functionality
  const typeFilter = document.getElementById('type-filter');
  typeFilter?.addEventListener('change', function() {
    const selectedType = this.value;

    if (selectedType === 'all') {
      directoryList.filter();
      layerIDs.forEach((layerID) => {
        map.setLayoutProperty(
          layerID,
          'visibility',
          'visible'
        );
      });
    } else {
      directoryList.filter(function(item) {
        return item.values().type === selectedType;
      });

      layerIDs.forEach((layerID) => {
        map.setLayoutProperty(
          layerID,
          'visibility',
          layerID.includes(selectedType) ? 'visible' : 'none'
        );
      });
    }
    // when we can be sure the forEach loop is complete, recenter the map
    setTimeout(() => {
      recenterMap();
    }, 0);
  });

  // Filter the sources in the map when the search input changes
  const searchInput = document.getElementById('search');
  searchInput?.addEventListener('keyup', (e: Event) => {
    const value = e.target.value.trim().toLowerCase();
    layerIDs.forEach((layerID) => {
      map.setLayoutProperty(
        layerID,
        'visibility',
        layerID.includes(value) ? 'visible' : 'none'
      );
    });
    // when we can be sure the forEach loop is complete, recenter the map
    setTimeout(() => {
      recenterMap();
    }, 0);
  });

  // Recenter the map based on visible layers
  function recenterMap() {
    const visibleLayers = layerIDs.filter((layerID) => map.getLayoutProperty(layerID, 'visibility') === 'visible');
    if (visibleLayers.length < layerIDs.length) {
      const features = map.queryRenderedFeatures({ layers: visibleLayers });
      const bounds = new LngLatBounds();
      features.forEach((feature) => {
        bounds.extend(feature.geometry.coordinates);
      });
      map.fitBounds(bounds, {
        padding: 100,
        maxZoom: 15
      });
    } else {
      // recenter map when all layers are visible
      map.setCenter([-98.5, 39.8]);
      map.setZoom(3);
    }
  }
</script>

<style is:global>
  .directory-container {
    display: grid;
    align-items: start;
    margin-block: var(--space-l);

    @media screen and (min-width: 768px) {
      column-gap: var(--space-xs);
      grid-template-columns: repeat(12, 1fr);
    }
  }

  /* Filters */
  .filters {
    top: 0;
    z-index: 10;
    width: 100%;
    position: sticky;
    grid-column: 1 / -1;
    padding-block: var(--space-s);
    background-color: var(--color-bg-primary);
  }

  /* Directory List */
  .directory-list {
    margin: 0;
    list-style: none;
    padding: var(--space-l) 0 0;

    .directory-list-item {
      border-top: 1px solid color-mix(in srgb, var(--color-fg-primary) 50%, transparent);

      &:last-child {
        border-bottom: 1px solid color-mix(in srgb, var(--color-fg-primary) 50%, transparent);
      }

      details {
        &[open] {
          .summary-icon svg {
            transform: rotate(180deg);
          }
        }
      }

      summary {
        display: flex;
        cursor: pointer;
        align-items: start;
        gap: var(--space-2xs);
        justify-content: space-between;
        padding: var(--space-xs) var(--space-3xs);

        &:hover,
        &:focus-visible {
          background-color: color-mix(in srgb, var(--color-fg-primary) 10%, transparent);
        }
      }

      .directory-list-item-header {
        display: flex;
        gap: var(--space-3xs);
        flex-direction: column;
      }

      .directory-list-item-content {
        display: flex;
        text-wrap: pretty;
        gap: var(--space-2xs);
        flex-direction: column;
        font-size: var(--step--1);
        margin-top: var(--space-s);
        padding-block-end: var(--space-s);
      }
    }

    @media screen and (min-width: 768px) {
      padding: 0;
      grid-column: 1 / 5;
    }
  }

  /* Map */
  .map-container {
    height: 500px;
    position: relative;

    @media screen and (min-width: 768px) {
      order: 2;
      position: sticky;
      grid-column: 5 / -1;
      top: calc(var(--space-l) * 2);
      height: calc(100vh - (var(--space-l) * 3));
    }
  }

  #map {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--space-3xs);
    
    &.maplibregl-map {
      font-family: var(--font-sans);
    }
  
    .maplibregl-popup-content {
      display: flex;
      gap: var(--space-3xs);
      flex-direction: column;
      font-size: var(--step--2);
      font-family: var(--font-mono);
      color: var(--color-bg-primary);
    }
  }

</style>