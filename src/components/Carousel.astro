---
import CloudImage from './CloudImage.astro';
import ArrowRight from '../assets/arrow-right.svg';
import ArrowLeft from '../assets/arrow-left.svg';

const { photos, item } = Astro.props;
---
<div class="splide carousel" role="group" aria-label={`${item.name} photos.`}>
  <div class="loader"><span class="loader-wrapper">🎃 🎃 🎃</span></div>
  <div class="splide__arrows">
    <button class="splide__arrow splide__arrow--prev">
      <span class="sr-only">Prev</span>
      <ArrowLeft />
    </button>
    <button class="splide__arrow splide__arrow--next">
      <span class="sr-only">Next</span>
      <ArrowRight />
    </button>
  </div>
  <div class="splide__track">
		<ul class="splide__list">
      {photos.map((photo) => (
        <li class="splide__slide">
          <CloudImage
            url={photo}
            width={1200}
            height={900}
            aspectRatio="4 / 3"
            alt={`${item.name} photo`}
            splide={true}
          />
        </li>
      ))}
		</ul>
  </div>
</div>

<style is:global>
  .carousel {
    width: 100%;
    overflow: clip;
    aspect-ratio: 4 / 3;
    content-visibility: auto;
    border-radius: var(--space-3xs);
    background-color: color-mix(in srgb, var(--color-fg-primary) 30%, transparent);
  }
  .loader {
    font-size: 2rem;
    position: absolute;
    display: inline-block;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    transform: translate(-50%, -50%);
  }
  .loader-wrapper {
    aspect-ratio: 4;
    clip-path: inset(0 100% 0 0);
    animation: l1 1s steps(4) infinite;
  }
  @keyframes l1 {to{clip-path: inset(0 -34% 0 0)}}

  /* Splide styles */
  .splide.carousel {
    .splide__arrow {
      top: auto;
      width: 1.5rem;
      height: 1.5rem;
      inset-block-end: 0;
      border-radius: var(--space-3xs);
      background: var(--color-fg-primary);
    }
  
    .splide__arrow--prev svg {
      transform: none;
    }
  
    .splide__pagination__page {
      background: var(--color-fg-primary);
      &.is-active {
        opacity: 1;
      }
    }
  }
</style>